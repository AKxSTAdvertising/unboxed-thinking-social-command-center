# Supabase public client configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Meta Developer App (Instagram + Facebook) — configure when enabling OAuth
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/oauth/meta/callback
META_GRAPH_API_VERSION=

# LinkedIn Developer App — configure when enabling OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/oauth/linkedin/callback

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Keep all secrets server-side. Never prefix secrets with NEXT_PUBLIC_.
